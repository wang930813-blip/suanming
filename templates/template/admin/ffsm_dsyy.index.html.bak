<{include file="admin/header.html"}>
<div class="app-content flex-column-fluid py-3 py-lg-6">
	<div class="app-container container-fluid">
	    
	    
		<div class="card card-flush">
			<div class="card-header align-items-center py-5 gap-2 gap-md-5">
				<div class="card-title">
					<form method="post" action="/acs/?ct=users&ac=index">
					    <div class="input-group">
    					    <input type="text" id="search_uid" name="uid_s" value="<{$sch_uid}>" placeholder="用户ID" class="form-control me-3">
    					    <input type="text" id="search_uid" name="sd_uid" value="<{$sd_uid}>" placeholder="上级用户ID" class="form-control me-3">
    					    <input type="text" id="search_user_name" name="sch_user_name" value="<{$sch_user_name}>" placeholder="用户账号" class="form-control me-3">
    					    <input type="text" id="search_phone" name="sch_phone" value="<{$sch_phone}>" placeholder="用户电话" class="form-control me-3">
    					    <button type="submit" class="btn btn-primary">搜索</button>
                        </div>
					    
					</form>
				</div>
				<div class="card-toolbar flex-row-fluid justify-content-end gap-5">
                    <form name="form1" action="?ct=users" method="POST">
                        <div class="fl">
                            <button type="button" class="btn btn-sm btn-light btn-active-primary" onclick="add_admin_modal()" >增加管理员</button>
                        </div>
                    </form>
                </div>
			</div>
			<div class="card-body pt-0" style="padding: 2rem 2.25rem 0rem 2.25rem;">
				<table class="table align-middle table-row-dashed fs-6 gy-5">
					<thead>
						<tr class="text-start text-gray-500 fw-bold fs-7 text-uppercase gs-0">
            				<th>
								<div class="form-check form-check-sm form-check-custom form-check-solid me-3">
									<input class="form-check-input" type="checkbox" name="checkbox" value="" rel="parent"/>
								</div>
							</th>
            				<th> 用户ID </th>
            				<th> 上级ID </th>
            				<th> 用户账号 </th>
            				<th> 用户昵称 </th>
            				<th> 用户等级 </th>
            				<th> 积分 </th>
            				<th> 独立提成</th>
                          	<th> 未提佣金 </th>
                          	<th> 全部佣金 </th>
                          	<th> 电话</th>
                          	<th> QQ </th>
            				<th> 权限组 </th>
            				<th> 注册时间 </th>
            				<th> 操作 </th>
						</tr>
					</thead>
					<tbody class="fw-semibold text-gray-600">
            			<{lurd_list item='v'}>
            			<tr>
            				<td> 
								<div class="form-check form-check-sm form-check-custom form-check-solid me-3">
									<input class="form-check-input" type="checkbox" name="uid[]" value="<{$v.uid}>" rel="child" />
								</div>
            				</td>
            				<td> <{$v.uid}> </td>
            				<td> <{$v.sd_uid}> </td>
            				<td> <{$v.user_name|truncate:8}> </td>
            				<td> 
            				    <a href="javascript:edit_user_modal('<{$v.uid}>');">
            				        <img src='images/images/icons/auditing.gif' alt='查看/修改' title='查看/修改' border='0' /> <{$v.nickname}>
            				    </a>
            			    </td>
            			    <td> <{if $v.vip_type==38}>包月VIP 到期时间：<{$v.vip_time|date_format:'%Y-%m-%d'}><{elseif $v.vip_type==39}>包年VIP 到期时间：<{$v.vip_time|date_format:'%Y-%m-%d'}><{elseif $v.vip_type==40}>终身VIP<{else}>普通用户<{/if}></td>
            				<td> <{$v.integral}></td>
                            <td> <{$v.dl_tcbl}>%</td>
                            <td> <{$v.dl_syjf|round:2}> </td>
                            <td> <{$v.dl_zjf|round:2}> </td>
                            <td> <{$v.phone}> </td>
                            <td> <{$v.qq}> </td>
            				<td> <{frame_union do='groups' var=$v.groups}> </td>
            				<td> <{lurd do="format_date" var=$v.regtime format="" }> </td>
            				<td>
								<a href="#" class="btn btn-sm btn-light btn-flex btn-center btn-active-light-primary" data-kt-menu-trigger="click" data-kt-menu-placement="bottom-end">更多操作 
								<i class="ki-duotone ki-down fs-5 ms-1"></i></a>
								<div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-600 menu-state-bg-light-primary fw-semibold fs-7 w-125px py-4" data-kt-menu="true">
									<div class="menu-item px-3">
										<a href="javascript:edit_user_modal('<{$v.uid}>');" class="menu-link px-3">修改</a>
									</div>
									<div class="menu-item px-3">
										<a onclick="do_delete_one('<{$v.uid}>')" class="menu-link px-3" data-kt-ecommerce-product-filter="delete_row">删除</a>
									</div>
								</div>
            				</td>
            			</tr>
            			<{/lurd_list}>
					</tbody>
				</table>
				<{$lurd_pagination}>
			</div>
		</div>
	</div>
</div>

<div class="modal fade" id="add_admin_modal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-600px">
        <div class="modal-content">
            <div class="modal-header">
                <h2>增加管理员</h2>
                <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                    <span class="svg-icon svg-icon-1">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1" transform="rotate(-45 6 17.3137)" fill="currentColor" />
                            <rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)" fill="currentColor" />
                        </svg>
                    </span>
                </div>
            </div>
            <div class="modal-body py-lg-10 px-lg-10">
                <iframe src="?ct=users&ac=index&even=add&tb=users&TB_iframe=true" style="border: none; width: 100%; height: 450px; overflow: hidden;" scrolling="no"></iframe>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="edit_user_modal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable mw-600px">
        <div class="modal-content">
            <div class="modal-header">
                <h2>增加管理员</h2>
                <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                    <span class="svg-icon svg-icon-1">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1" transform="rotate(-45 6 17.3137)" fill="currentColor" />
                            <rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)" fill="currentColor" />
                        </svg>
                    </span>
                </div>
            </div>
            <div class="modal-body py-lg-10 px-lg-10">
                <iframe id="edit_user" style="border: none; width: 100%; height: 130vh; overflow: hidden;" scrolling="no"></iframe>
            </div>
        </div>
    </div>
</div>
<{include file='admin/footer.html'}>
<script src="/acs/demo1/plugins/custom/datatables/datatables.bundle.js"></script>
<script src="/acs/demo1/js/custom/apps/ecommerce/catalog/products.js"></script>

<script src="images/js/jquery.js" type="text/javascript"></script>
<script src="images/js/util.js" type="text/javascript"></script>
<script src="images/js/frm.js" type="text/javascript"></script>
<script src="images/js/tb-box.js" type="text/javascript"></script>



<script lang='javascript'>
function add_admin_modal() {
    $('#add_admin_modal').modal('show');
}
function edit_user_modal(nid) {
    $('#edit_user_modal').modal('show');
    
    var iframe = document.getElementById('edit_user');
    var iframeSrc = '?ct=users&ac=index&even=edit&tb=users&uid='+ nid +'&TB_iframe=true&height=350&width=500';
    iframe.src = iframeSrc;
    
}

function do_delete()
{
	document.form1.even.value = 'delete';
	var msg = "你确定要删除选中的用户？！";
	msg += "<br/><a href='javascript:tb_remove();'>&lt;&lt;点错了</a> &nbsp;|&nbsp; <a href='javascript:document.form1.submit();'>确定要删除&gt;&gt;</a>";
	tb_showmsg(msg);
}


function do_delete_one(uid) {
    Swal.fire({
        title: '确定删除商户吗？', 
        showDenyButton: true,
        confirmButtonText: '确定删除',
        denyButtonText: '取消删除',
        customClass: {
            confirmButton: "btn btn-primary",
            denyButton: 'btn btn-danger'
        }
    }).then((result) => {
        if (result.isConfirmed) {
            var deleteLink = "?ct=users&ac=index&even=delete&tb=users&uid[]=" + uid + "&TB_iframe=true&height=400&width=500";
            window.location.href = deleteLink; // 提交删除链接
        }
    })
}
</script>