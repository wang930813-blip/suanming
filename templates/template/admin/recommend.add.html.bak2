<link href="/acs/demo1/plugins/custom/fullcalendar/fullcalendar.bundle.css" rel="stylesheet" type="text/css" />
<link href="/acs/demo1/plugins/custom/datatables/datatables.bundle.css" rel="stylesheet" type="text/css" />
<link href="/acs/demo1/plugins/global/plugins.bundle.css" rel="stylesheet" type="text/css" />
<link href="/acs/demo1/css/style.bundle.css" rel="stylesheet" type="text/css" />
<style>
  .image-input-placeholder {
    background-color: #eee;
  }

  [data-bs-theme="dark"] .image-input-placeholder {
    background-color: #000;
  }
</style>
    <form name="form1" jstype="vali" action="?ct=recommend&ac=index&even=saveadd&tb=recommend" method="POST" enctype="multipart/form-data" style="background-color:#fff;">
        <div class="fv-row mb-6">
            <label class="form-label">标题：</label>
            <input type='input' name='form[title]' class="form-control" />
        </div>
        <div class="fv-row mb-6">
            <label class="form-label">链接：</label>
            <input type='input' name='form[url]' class="form-control"/>
        </div>
        <div class="fv-row mb-6">
            <label class="form-label">图片：</label>
            <div class="fv-row mb-12">
              <div class="image-input image-input-empty image-input-placeholder" data-kt-image-input="true">
                <div class="image-input-wrapper w-85px h-85px"></div>
                <label class="btn btn-icon btn-circle btn-color-muted btn-active-color-primary w-25px h-25px bg-body shadow"
                  data-kt-image-input-action="change" data-bs-toggle="tooltip" data-bs-dismiss="click" title="Change avatar">
                  <i class="ki-duotone ki-pencil fs-6">
                    <span class="path1"></span>
                    <span class="path2"></span></i>
                  <input id="imgUpload" type="file" name='file' accept=".png, .jpg, .jpeg" />
                  <input id="formImage" type="hidden" name='form[base64]' />
                  <!--end::Inputs-->
                </label>
                <span class="btn btn-icon btn-circle btn-color-muted btn-active-color-primary w-25px h-25px bg-body shadow"
                  data-kt-image-input-action="cancel" data-bs-toggle="tooltip" data-bs-dismiss="click" title="Cancel avatar">
                  <i class="ki-outline ki-cross fs-3"></i>
                </span>
                <span class="btn btn-icon btn-circle btn-color-muted btn-active-color-primary w-25px h-25px bg-body shadow"
                  data-kt-image-input-action="remove" data-bs-toggle="tooltip" data-bs-dismiss="click" title="Remove avatar">
                  <i class="ki-outline ki-cross fs-3"></i>
                </span>
              </div>
            </div>
        </div>
        <div class="fv-row mb-6">
            <label class="form-label">描述：</label>
            <textarea class='form-control' name='form[description]'></textarea>
        </div>
        <div class="text-center">
            <button type="reset" class="btn btn-light w-25 me-3">重置</button>
            <button type="submit" class="btn btn-primary w-25">保存</button>
        </div>
    </form>

    <script src="/acs/demo1/plugins/global/plugins.bundle.js"></script>
    <script src="/acs/demo1/js/scripts.bundle.js"></script>
    <script language='javascript'>
      $("#imgUpload").change(function (event) {
        var base64
        var file = event.target.files[0]
        if (file) {
          var reader = new FileReader(); // 创建FileReader对象
          reader.onload = function (e) {
            $('#formImage').val(e.target.result)
          };
          reader.readAsDataURL(file);
        }
      })
    </script>