<{include file="admin/header.html"}>
<div class="app-content flex-column-fluid py-3 py-lg-6">
	<div class="app-container container-fluid">
        <div class="card">
            <div class="card-header">
                <div class="card-title">
                    <h2><{$web_title}></h2>
                </div>
            </div>
            <div class="card-body pb-5">
                <form name="myform" jstype="vali" action="?ct=system&ac=<{$ac_url}>" method="POST"  enctype="multipart/form-data">
                <div id="setting_tab_content" class="tab-content">
                    <div id="setting_1" class="py-0 tab-pane fade show active" role="tabpanel">
                        <div class="card-body">
                            
<input type="hidden" name="even" value="saveedit" />
<table width="100%" class="form">
<{foreach from=$sys_all key=k item=v}>
  <{if $v.name=="pay_type"}>
   
<div class="fv-row row mb-9">
    <div class="col-md-3 d-flex align-items-center">
        <label class="fs-6 fw-semibold">显示支付方式</label>
    </div>
    <div class="col-md-9 d-flex">
        
        <div class="form-check form-check-custom form-check-solid me-5">
            <input class="form-check-input h-25px w-25px" type="checkbox" <{if $payMethod.wechat==1}>checked<{/if}> name="sys[pay_type][1]" value="1" id="wechat"/>
            <label class="form-check-label" for="wechatPay">
                微信支付
            </label>
        </div>
        <div class="form-check form-check-custom form-check-solid me-5">
            <input class="form-check-input h-25px w-25px" type="checkbox" <{if $payMethod.alipay==1}>checked<{/if}> name="sys[pay_type][2]" value="2" id="alipay"/>
            <label class="form-check-label" for="alipay">
                支付宝支付
            </label>
        </div>
        <div class="form-check form-check-custom form-check-solid me-5">
            <input class="form-check-input h-25px w-25px" type="checkbox" <{if $payMethod.other==1}>checked<{/if}>  name="sys[pay_type][4]" value="4" id="other"/>
            <label class="form-check-label" for="other">
                3方支付
            </label>
        </div>
        <div class="form-check form-check-custom form-check-solid me-5">
            <input class="form-check-input h-25px w-25px" type="checkbox" <{if $payMethod.paypal==1}>checked<{/if}>  name="sys[pay_type][5]" value="5" id="paypal"/>
            <label class="form-check-label" for="paypal">
                paypal支付
            </label>
        </div>
        <div class="form-check form-check-custom form-check-solid me-5">
            <input class="form-check-input h-25px w-25px" type="checkbox" <{if $payMethod.stripe==1}>checked<{/if}>  name="sys[pay_type][6]" value="6" id="stripe"/>
            <label class="form-check-label" for="stripe">
                Stripe支付
            </label>
        </div>
    </div>
</div>
 <{/if}>
<{if $v.name=="mobanqh"}>
<div class="fv-row row mb-9">
    <div class="col-md-3 d-flex align-items-center">
        <label class="fs-6 fw-semibold">首页模板切换</label>
    </div>
    <div class="col-md-9">
        <select class="form-select" data-control="select2" data-placeholder="选择支付方式"  name="sys[<{$v.name}>][0]" id="equestion" >
            <option value="5" <{if $v.config==5}>selected<{/if}> >默认模板</option>
        </select>
        <input type='hidden' name='sys[<{$v.name}>][1]' class="text s"  value='<{$v.title}>' />
        <input type='hidden' name='sys[<{$v.name}>][2]' class="text s"  value='<{$v.class}>' />
    </div>
</div>
 <{/if}>
  <{if $v.name=="tjex_on"}>
<div class="fv-row row mb-9">
    <div class="col-md-3 d-flex align-items-center">
        <label class="fs-6 fw-semibold">推广积分是否开启</label>
    </div>
    <div class="col-md-9">
        <select class="form-select" data-control="select2" data-placeholder="选择支付方式"  name="sys[<{$v.name}>][0]" id="equestion" >
            <option value="0"  <{if $v.config==0}>selected<{/if}> >关闭</option>
            <option value="1" <{if $v.config==1}>selected<{/if}> >开启</option>
        </select>
        <input type='hidden' name='sys[<{$v.name}>][1]' class="text s"  value='<{$v.title}>' />
        <input type='hidden' name='sys[<{$v.name}>][2]' class="text s"  value='<{$v.class}>' />
    </div>
</div>
 <{/if}>
  <{if $v.name=="vip_on"}>
<div class="fv-row row mb-9">
    <div class="col-md-3 d-flex align-items-center">
        <label class="fs-6 fw-semibold">VIP是否开启</label>
    </div>
    <div class="col-md-9">
        <select class="form-select" data-control="select2" data-placeholder="选择支付方式"  name="sys[<{$v.name}>][0]" id="equestion" >
            <option value="0"  <{if $v.config==0}>selected<{/if}> >关闭</option>
            <option value="1" <{if $v.config==1}>selected<{/if}> >开启</option>
        </select>
        <input type='hidden' name='sys[<{$v.name}>][1]' class="text s"  value='<{$v.title}>' />
    	<input type='hidden' name='sys[<{$v.name}>][2]' class="text s"  value='<{$v.class}>' />
    </div>
</div>
 <{/if}>
  <{if $v.name=="stripe_secret_key" || $v.name=="stripe_public_key" || $v.name=="stripe_webhook_secret" || $v.name=="stripe_currency" || $v.name=="stripe_mode"}>
<div class="fv-row row mb-9">
    <div class="col-md-3 d-flex align-items-center">
        <label class="fs-6 fw-semibold"><{$v.title}></label>
    </div>
    <div class="col-md-9">
        <{if $v.name=="stripe_mode"}>
            <select class="form-select" name="sys[<{$v.name}>][0]">
                <option value="test" <{if $v.config=='test'}>selected<{/if}>>测试模式</option>
                <option value="live" <{if $v.config=='live'}>selected<{/if}>>正式模式</option>
            </select>
        <{else}>
            <input type="text" name="sys[<{$v.name}>][0]" value="<{$v.config}>" class="form-control">
        <{/if}>
        <input type='hidden' name='sys[<{$v.name}>][1]' class="text s"  value='<{$v.title}>' />
        <input type='hidden' name='sys[<{$v.name}>][2]' class="text s"  value='<{$v.class}>' />
    </div>
</div>
<{/if}>
<{/foreach}>
<{foreach from=$sys_all key=k item=v}>
<{if $v.name!="pay_type" && $v.name!="tjex_on" && $v.name!="vip_on" && $v.name!="mobanqh" && $v.name!="stripe_secret_key" && $v.name!="stripe_public_key" && $v.name!="stripe_webhook_secret" && $v.name!="stripe_currency" && $v.name!="stripe_mode"}>
<div class="fv-row row mb-9">
    <div class="col-md-3 d-flex align-items-center">
        <label class="fs-6 fw-semibold"><{$v.title}></label>
    </div>
    <div class="col-md-9">
        <input type="text" name="sys[<{$v.name}>][0]" value="<{$v.config}>" class="form-control">
        <input type='hidden' name='sys[<{$v.name}>][1]' class="text s"  value='<{$v.title}>' />
        <input type='hidden' name='sys[<{$v.name}>][2]' class="text s"  value='<{$v.class}>' />
    </div>
</div>
<{/if}>
<{/foreach}>
<tr>
  <td colspan='2' align='left' height='30' >
  </td>
</tr>
</table>
                            
                            
                            
                            
                            
                            
                            
                            
                            
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="card-footer d-flex justify-content-end py-6 px-9">
                        <input type='hidden' name='dosubmit' value='true'/>
                        <button type="submit" class="btn btn-primary">保存设置</button>
                    </div>
                </div>
</form>
            </div>
        </div>
    </div>
</div>
<{include file='admin/footer.html'}>
<script>

</script>
