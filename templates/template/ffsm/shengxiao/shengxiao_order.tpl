<script>
$(document).ready(function() {
    // 生肖计算函数
    function getShengxiao(year) {
        var shengxiaoArr = ['猴', '鸡', '狗', '猪', '鼠', '牛', '虎', '兔', '龙', '蛇', '马', '羊'];
        return shengxiaoArr[year % 12];
    }
    
    // 高亮生肖函数
    function highlightShengxiao(shengxiao) {
        if (!shengxiao) return;
        
        $('#mingpanList li').each(function() {
            var liShengxiao = $(this).attr('data-sx');
            if (liShengxiao === shengxiao) {
                $(this).addClass('active');
            }
        });
    }
    
    // 从localStorage读取并显示生辰数据
    var storedData = localStorage.getItem('shengxiao_form_data');
    var shengxiao = null;
    
    if (storedData) {
        try {
            var formData = JSON.parse(storedData);
            
            // 计算生肖
            var year = parseInt(formData.year);
            shengxiao = getShengxiao(year);
            
            // 高亮对应的生肖图标
            highlightShengxiao(shengxiao);
            
            // 显示用户实际输入的内容（datetext已包含"农历"或"阳历"前缀）
            var displayText = formData.datetext || (formData.year + '年' + formData.month + '月' + formData.day + '日 ' + formData.hour + '时');
            
            // 命盘用户信息区域
            $('#birthdayLi').show();
            $('#birthdayDisplay').text(displayText);
            
            // 订单信息区域
            $('#orderBirthday').text(displayText);
        } catch(e) {
            $('#birthdayDisplay').text('数据加载失败');
            $('#birthdayLi').show();
        }
    } else {
        $('#birthdayDisplay').text('请重新填写表单');
        $('#birthdayLi').show();
    }
    
    // 如果没有localStorage数据，使用后端传的生肖值
    if (!shengxiao) {
        shengxiao = '<{$shengxiao}>';
        if (shengxiao) {
            highlightShengxiao(shengxiao);
        }
    }
    
    // 命盘动画完成后自动切换到订单内容
    setTimeout(function() {
        // 隐藏命盘动画
        $('#initAnim').fadeOut(1000, function() {
            // 显示订单内容区域
            $('#guideContent').show().css('display', 'block');
        });
    }, 6000); // 6秒后开始切换（等待所有动画完成）
    
    // 点击命盘区域提前切换
    $('#initAnim').click(function() {
        // 隐藏命盘动画
        $(this).fadeOut(1000, function() {
            // 显示订单内容区域
            $('#guideContent').show().css('display', 'block');
        });
    });
    
    // 支付弹窗控制
    $('.J_payPopupShow').click(function() {
        $('#publicPayPopup').show();
    });
    
    $('#publicPayBottom').click(function() {
        $('#publicPayPopup').show();
    });
    
    $('#publicPPClose').click(function() {
        $('#publicPayPopup').hide();
    });
    
    // 支付按钮处理 - 直接跳转到支付页面
    $('.J_payWepayQrcode, .J_payAlipayQrcode').click(function(e) {
        var href = $(this).attr('href');
        if (href && href !== '#' && href !== 'javascript:void(0);' && href !== 'javascript:;') {
            // 直接跳转到支付页面
            window.location.href = href;
            return false;
        }
        // 如果没有有效的href，阻止默认行为
        e.preventDefault();
        return false;
    });
    
});
</script>

