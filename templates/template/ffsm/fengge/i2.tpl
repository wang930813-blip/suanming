$('#alertMarquee').each(function(){
    $('.contents').addClass('has-alert-marquee');

    var $this = $(this);
    var $cont = $this.find('.inner');
    var w = $this.width();
    var sw = w + $cont.width();
    var n = w / 375 * 1;
    var i = 0;
    var movingFn = function(){
        i = i + n;
        if(i > sw){
            i = 0;
        }
        $cont.css({'margin-left': -i });
        window.requestAnimFrame(movingFn)
    }
    window.requestAnimFrame(movingFn)
});
</script>
