<script type="text/javascript">
    var intDiff = parseInt(899);//倒計時總秒數量
    var hongbaointDiff = parseInt(899);//倒計時總秒數量
    function timer(intDiff){
        window.setInterval(function(){
            var day=0,
                hour=0,
                minute=0,
                second=0;//時間默認值
            if(intDiff > 0){
                day = Math.floor(intDiff / (60 * 60 * 24));
                hour = Math.floor(intDiff / (60 * 60)) - (day * 24);
                minute = Math.floor(intDiff / 60) - (day * 24 * 60) - (hour * 60);
                second = Math.floor(intDiff) - (day * 24 * 60 * 60) - (hour * 60 * 60) - (minute * 60);
            }
            if (minute <= 9) minute = '0' + minute;
            if (second <= 9) second = '0' + second;
            $('#day_show').html(day+"天");
            $('#hour_show').html('<s id="h"></s>'+hour+'');
            $('#hour_show2').html('<s id="h"></s>'+hour+'');
            $('#minute_show').html('<s></s>'+minute+'');
            $('#minute_show2').html('<s></s>'+minute+'');
            $('#second_show').html('<s></s>'+second+'');
            $('#second_show2').html('<s></s>'+second+'');
            //$('#hour_show').html('<s id="h"></s>'+hour+'小時');
            //$('#minute_show').html('<s></s>'+minute+'分');
            //$('#second_show').html('<s></s>'+second+'秒');
            intDiff--;
        }, 1000);
    }
    //红包计时
    function hongbaotimer(hongbaointDiff){
        window.setInterval(function(){
            var day1=0,
                hour1=0,
                minute1=0,
                second1=0;//時間默認值
            if(hongbaointDiff > 0){
                day1 = Math.floor(hongbaointDiff / (60 * 60 * 24));
                hour1 = Math.floor(hongbaointDiff / (60 * 60)) - (day1 * 24);
                minute1 = Math.floor(hongbaointDiff / 60) - (day1 * 24 * 60) - (hour1 * 60);
                second1 = Math.floor(hongbaointDiff) - (day1 * 24 * 60 * 60) - (hour1 * 60 * 60) - (minute1 * 60);
            }
            if (minute1 <= 9) minute1 = '0' + minute1;
            if (second1 <= 9) second1 = '0' + second1;
            $('#second_show1').html('<s></s>'+second1+'');
            $('#minute_show1').html('<s></s>'+minute1+'');
            hongbaointDiff--;
        }, 1000);
    }
    $(function(){
        timer(intDiff);
    });
    //支付后检测跳转
    </script>
