  }
function setSex(that) {
  // color: rgb(255, 255, 255); background-color: rgb(249, 86, 68); border-color: rgb(249, 86, 68);
    // that.style = 'color: rgb(255, 255, 255); background-color: rgb(238, 200, 122); border-color: rgb(238, 200, 122);'
    $(that).css({
      'color':'rgb(255, 255, 255)',
      'background-color':'rgb(249, 86, 68)',
      'border-color':'rgb(249, 86, 68)',
    })
    $(that).addClass('uni-radio-input-checked')
    var oid = (that.id == 'gender_0'?'gender_1':'gender_0')
    var ids = ['gender_0','gender_1']
    var value = ids.findIndex(v=>{
      return v==that.id
    })
    var displayIds = ids.filter(v=>{
      return v!=that.id
    })
    for (let key = 0; key < displayIds.length; key++) {
      const v = displayIds[key];
      $('#'+v).removeClass('uni-radio-input-checked')
      $('#'+v).removeAttr('style')
    }
    document.login.gender.value = value;
    // console.log(('#'+oid))
    // $('#'+oid).removeClass('uni-radio-input-checked')
    // $('#'+oid).removeAttr('style')
  }
