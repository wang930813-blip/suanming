<script type="text/javascript">
    function ajaxSelectChange(id,tag,url){
        if(id<1)return false;
        var currentValue = $('.'+tag).attr('currentValue');
        $.post(
                url,
                {id:id,currentValue:currentValue},
                function(data){
                    if(data.str=='success'){
                        $('.'+tag).html(data.data);
                        layui.form.render('select');
                    }else{
                        alert(data.str);
                    }
                },
                'json'
        );
    }
</script>

