<script>
	$('.top-ermenue').each(function(){
		// 本地存储
		var store = {
			set: function(key, val){
				localStorage.setItem(key, JSON.stringify(val));
			},
			get: function(key){
				return JSON.parse(localStorage.getItem(key));
			}
		}
		var $this = $(this);
		var linkStr  = store.get('topLinkStr');
		linkStr && $this.html(linkStr);
		$.ajax({
			url:"/mobile/index/topZhiwei/",
			dataType:"json",
			type: 'GET',
			data:{
				type:'mdh',
				qudao: window.qudao || '',
			},
			success: function (res) {
				if (res.ret) {
					$this.html(res.zhiweiStr);
					store.set('topLinkStr', res.zhiweiStr);
					var $item = $this.find('.active');
					var i = 0;
					var ani = function(time){
						setTimeout(function(){
							if(i >= $item.length) i = 0;
							$item.removeClass('on').eq(i).addClass('on');
							ani(4800);
							i++;
						}, time);
					}
					ani(0);
				}else{
					window.layer && setTimeout(function(){
						layer.msg('抱歉，加载数据失败');
					}, 1500)
				}
			}
		});
	})
</script>
<script>
    //top fixed
    var regexp=/\.(sogou|so|sm)(\.[a-z0-9\-]+){1,2}\//ig;
    var regexp2=/\.(baidu)(\.[a-z0-9\-]+){1,2}\//ig;
    var where = document.referrer;
    var IsBodyfixed = sessionStorage.getItem('IsBodyfixed');
    if(IsBodyfixed==1){
        if(regexp2.test(where)) {
            sessionStorage.setItem('IsBodyfixed',0);
            $('body').removeClass('bodyfixed');
        }else{
            $('body').addClass('bodyfixed');
        }
    } else if(regexp.test(where)) {
        $.ajax({
            url: "/mobile/common/topfixed/",
            dataType: 'json',
            success: function (data) {
                if(data.ret==1){
                    sessionStorage.setItem('IsBodyfixed',1);
                    $('body').addClass('bodyfixed');
                }else{
                    sessionStorage.setItem('IsBodyfixed',0);
                }
            }
        });
    }
</script></div><div class="whitbox pat1">
